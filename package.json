{
  "name": "@p2flux/mcp",
  "version": "0.3.5",
  "description": "Let your AI assistant find and pay for web content with USDC (x402), within limits you set. The wallet stays on your computer.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "p2flux-mcp": "./dist/index.js",
    "p2flux-mcp-remote": "./dist/remote.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "SKILL.md",
    "manifest.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@x402/core": "2.32.0",
    "@x402/evm": "2.32.0",
    "@x402/fetch": "2.32.0",
    "viem": "^2.21.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/P2Flux/mcp.git"
  },
  "homepage": "https://github.com/P2Flux/mcp#readme",
  "publishConfig": {
    "access": "public"
  },
  "mcpName": "io.github.P2Flux/mcp",
  "overrides": {
    "body-parser": ">=2.4.0",
    "qs": ">=6.16.1",
    "ip-address": ">=10.7.4",
    "fast-uri": "^3.1.9"
  }
}
