{
  "name": "@p2flux/mcp",
  "version": "0.2.0",
  "description": "Let your AI assistant find and pay for web content with USDC (x402), within limits you set. The wallet stays on your computer.",
  "license": "MIT",
  "type": "module",
  "bin": { "p2flux-mcp": "./dist/index.js", "p2flux-mcp-remote": "./dist/remote.js" },
  "main": "./dist/index.js",
  "files": ["dist", "README.md", "SKILL.md", "manifest.json"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@x402/core": "2.27.0",
    "@x402/evm": "2.27.0",
    "@x402/fetch": "2.27.0",
    "viem": "^2.21.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
